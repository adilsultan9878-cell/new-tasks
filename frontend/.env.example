# Base URL of the API. Leave empty in development: Vite proxies /api to the backend.
# Production example (Cloudflare Pages build variable): https://sentinel-x-api.onrender.com/api/v1
VITE_API_BASE_URL=
# Where the Vite dev server proxies /api (development only)
VITE_DEV_API_PROXY=http://127.0.0.1:8000
