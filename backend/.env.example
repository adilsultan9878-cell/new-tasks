# ---------------------------------------------------------------------------------------------
# SENTINEL X — AEGIS NEXUS API configuration. Copy to backend/.env and adjust.
# Never commit real secrets. Every value can also be set as a real environment variable.
# ---------------------------------------------------------------------------------------------

# development | test | production   (production enforces the security checks in app/core/config.py)
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database ---------------------------------------------------------------------------------
# Quick start (no install needed): SQLite file in the backend folder.
DATABASE_URL=sqlite:///./sentinel_dev.db
# PostgreSQL via docker compose (recommended; enables Row-Level Security):
#   DATABASE_URL=postgresql://sentinel_app:sentinel_app_dev_password@localhost:5432/sentinel
#   MIGRATION_DATABASE_URL=postgresql://postgres:postgres_dev_password@localhost:5432/sentinel
# Supabase: use the connection string from Project Settings → Database (session pooler, port 5432).
MIGRATION_DATABASE_URL=

# --- Authentication ---------------------------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leave empty in development to use a random per-process secret.
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
# Local dev over http: false / lax. Production over https: true; use "none" only when the
# frontend and API are on different sites (see docs/DEPLOYMENT.md).
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
ALLOW_REGISTRATION=true

# --- HTTP -------------------------------------------------------------------------------------
# Comma-separated list of allowed browser origins (the frontend URL).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_DEFAULT_PER_MINUTE=300

# --- Threat intelligence (optional; free accounts) ---------------------------------------------
# Without keys these providers show "not configured"; investigations still run deterministic
# checks plus RDAP, DNS, CISA KEV and NVD (no key needed).
# URLhaus + MalwareBazaar (one key for both): https://auth.abuse.ch/
ABUSECH_AUTH_KEY=
# https://www.abuseipdb.com/register
ABUSEIPDB_API_KEY=
# https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=
# Optional, raises NVD rate limits: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
# Disable all outbound intelligence lookups (air-gapped labs, CI):
# INTEL_OFFLINE=true

# --- Security Brain (Phase 4) ---------------------------------------------------------------
# Deterministic engine only; "none" is the only supported value (no AI model is used).
# AI_PROVIDER=none
# Analyse every new alert automatically:
# BRAIN_AUTO_TRIAGE=true
# BRAIN_LOOKBACK_DAYS=7

# --- SOC (Phase 5) ---------------------------------------------------------------------------
# Pending approvals for medium/high impact response actions expire after:
# APPROVAL_TTL_HOURS=24
# Evidence files are stored in the database (immutable); per-file limit in bytes:
# EVIDENCE_MAX_BYTES=5000000
